# Copy this file to .env and fill in values. Do NOT commit .env with secrets.

# Core
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (Postgres)
DB_NAME=cravehub_db
DB_USER=postgres
DB_PASSWORD=postgrespassword
DB_HOST=localhost
DB_PORT=5432

# JWT
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=30

# Redis (optional)
REDIS_URL=

# Razorpay (test keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# OpenAI / Anthropic
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-2.1

# Email / SMTP
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@cravehub.local

# SMS gateway (optional)
SMS_GATEWAY_EMAIL_DOMAIN=

# Sentry (optional)
SENTRY_DSN=
# Copy to .env and fill values
SECRET_KEY=change-me-to-a-secure-value
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DB_NAME=cravehub_db
DB_USER=postgres
DB_PASSWORD=root
DB_HOST=localhost
DB_PORT=5432
# Redis for channels (use docker-compose service 'redis' in production)
REDIS_URL=redis://redis:6379/0
# External APIs
OPENAI_API_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_TEST_MODE=True
ANTHROPIC_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-2.1
# Google Gemini (optional): set if you want to use Google's Generative API
GEMINI_KEY=
GEMINI_MODEL=text-bison-001

# SMTP / Email (optional) — used for transactional email and email-to-SMS gateways
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-smtp-user
EMAIL_HOST_PASSWORD=your-smtp-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@cravehub.local

# Optional: If your SMS provider accepts email-to-SMS, set the domain used to reach mobiles.
# e.g. for testing you might set SMS_GATEWAY_EMAIL_DOMAIN=txt.example.com and then emails to
# 919999999999@txt.example.com will be delivered as SMS to that number by the provider.
SMS_GATEWAY_EMAIL_DOMAIN=

# Optional production security
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
